<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <Preference
        android:selectable="false"
        android:summary="@string/lan_menu_summary"/>
    <PreferenceCategory android:title="@string/lan_this_device">
        <EditTextPreference
            android:persistent="false"
            android:title="@string/lan_device_name"
            android:key="lan_name"
            android:dialogTitle="@string/lan_device_name"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/lan_receiver_role">
        <SwitchPreference
            android:persistent="false"
            android:title="@string/lan_allow"
            android:key="lan_receiver_enabled"
            android:summary="@string/lan_receiver_summary"/>
        <SwitchPreference
            android:persistent="false"
            android:title="@string/lan_pair_new"
            android:key="lan_pairing_enabled"
            android:summary="@string/lan_pairing_closed"
            app:isPreferenceVisible="false"/>
        <PreferenceCategory
            android:title="@string/lan_paired"
            android:key="lan_paired_controllers"
            app:isPreferenceVisible="false"/>
        <PreferenceCategory
            android:title="@string/lan_pair_requests"
            android:key="lan_pair_requests"
            app:isPreferenceVisible="false"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/lan_controller_role">
        <Preference
            android:icon="@drawable/ic_navigate_next"
            android:title="@string/lan_search"
            android:key="lan_find_devices"
            android:summary="@string/lan_controller_summary"/>
        <Preference
            android:selectable="false"
            android:key="lan_setup_status"
            android:summary="@string/lan_search_hint"/>
        <Preference
            android:title="@string/lan_controlled_device"
            android:selectable="false"
            android:key="lan_controlled_device"
            app:isPreferenceVisible="false"/>
        <Preference
            android:title="@string/lan_release_control"
            android:key="lan_release_device"
            android:summary="@string/lan_release_summary"
            app:isPreferenceVisible="false"/>
        <PreferenceCategory
            android:title="@string/lan_available_devices"
            android:key="lan_available_devices"
            app:isPreferenceVisible="false"/>
    </PreferenceCategory>
</PreferenceScreen>
