<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/aura_home_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/search_result_nested_scroll_view"
        android:background="@drawable/aura_home_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/searchbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/search_result_layout"
            android:paddingTop="64dp"
            android:paddingBottom="@dimen/global_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/search_artist_sector"
                android:paddingBottom="8dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:paddingTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/search_title_artist"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    style="@style/TitleLarge"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/search_result_artist_recycler_view"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/search_album_sector"
                android:paddingBottom="8dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:paddingTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/search_title_album"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    style="@style/TitleLarge"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/search_result_album_recycler_view"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/search_song_sector"
                android:paddingBottom="8dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:paddingTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/search_title_song"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    style="@style/TitleLarge"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/search_result_tracks_recycler_view"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:id="@+id/allSongs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/search_all_songs_loading"
                    android:paddingStart="16dp"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/allsongsview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/emptyResponseContainer"
                android:paddingTop="@dimen/_150sdp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ui_empty_response"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"
                    android:maxWidth="240dp"
                    android:maxHeight="240dp"/>
                <TextView
                    android:paddingTop="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/search_title_empty_response"
                    style="@style/LabelMedium"/>
                <TextView
                    android:gravity="center_horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/search_description_empty_response"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    style="@style/LabelSmall"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.appbar.AppBarLayout
        android:background="@drawable/aura_toolbar_gradient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp">
        <com.google.android.material.search.SearchBar
            android:id="@+id/search_bar"
            android:background="@drawable/aura_toolbar_gradient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/search_hint"
            app:backgroundTint="@color/md_theme_dark_surface"
            app:elevation="0dp"/>
    </com.google.android.material.appbar.AppBarLayout>
    <com.google.android.material.search.SearchView
        android:id="@+id/search_view"
        android:background="@drawable/aura_home_background"
        android:fitsSystemWindows="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:hint="@string/search_hint"
        app:backgroundTint="@color/md_theme_dark_background"
        app:elevation="0dp"
        app:hideNavigationIcon="false"
        app:layout_anchor="@+id/search_bar"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="#fff4f1ff">
        <ScrollView
            android:background="@drawable/aura_home_background"
            android:paddingBottom="@dimen/global_padding_bottom"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/search_view_suggestion_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
    </com.google.android.material.search.SearchView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
