<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="8dp">
    <ImageView
        android:id="@+id/continue_listening_cover_image_view"
        android:background="?attr/colorSurfaceContainerHighest"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15sp"
        android:textColor="?android:attr/textColorPrimary"
        android:ellipsize="end"
        android:id="@+id/continue_listening_title_label"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:fontFamily="@font/inter"
        android:textFontWeight="600"
        app:layout_constraintEnd_toEndOf="@+id/continue_listening_cover_image_view"
        app:layout_constraintStart_toStartOf="@+id/continue_listening_cover_image_view"
        app:layout_constraintTop_toBottomOf="@+id/continue_listening_cover_image_view"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?android:attr/textColorSecondary"
        android:ellipsize="end"
        android:id="@+id/continue_listening_album_label"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="@font/inter"
        app:layout_constraintEnd_toEndOf="@+id/continue_listening_cover_image_view"
        app:layout_constraintStart_toStartOf="@+id/continue_listening_cover_image_view"
        app:layout_constraintTop_toBottomOf="@+id/continue_listening_title_label"/>
    <TextView
        android:textSize="12sp"
        android:textColor="?attr/colorPrimary"
        android:id="@+id/continue_listening_resume_label"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        app:layout_constraintEnd_toEndOf="@+id/continue_listening_cover_image_view"
        app:layout_constraintStart_toStartOf="@+id/continue_listening_cover_image_view"
        app:layout_constraintTop_toBottomOf="@+id/continue_listening_album_label"/>
</androidx.constraintlayout.widget.ConstraintLayout>
