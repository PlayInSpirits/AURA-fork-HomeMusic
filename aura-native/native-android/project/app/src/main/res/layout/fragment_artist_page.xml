<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/appbar_header_height">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="?attr/colorSurface"
            app:expandedTitleMarginStart="@dimen/activity_margin_content"
            app:layout_scrollFlags="snap|exitUntilCollapsed|scroll">
            <ImageView
                android:id="@+id/artist_backdrop_image_view"
                android:fitsSystemWindows="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:layout_collapseMode="parallax"/>
            <View
                android:layout_gravity="top"
                android:background="@drawable/gradient_backdrop_background_image"
                android:layout_width="match_parent"
                android:layout_height="@dimen/appbar_header_height"/>
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/anim_toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"/>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/fragment_artist_page_nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:paddingBottom="120dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/upper_button_divider"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                style="@style/Divider"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/album_page_button_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <Button
                        android:id="@+id/artist_page_shuffle_button"
                        android:padding="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/artist_page_shuffle_button"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        app:icon="@drawable/ic_shuffle"
                        app:iconGravity="textStart"
                        app:iconPadding="18dp"/>
                    <Button
                        android:id="@+id/artist_page_wave_button"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/homemusic_wave_by_artist"
                        android:layout_weight="1"
                        android:textAllCaps="false"/>
                    <Button
                        android:id="@+id/artist_page_radio_button"
                        android:padding="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/artist_page_radio_button"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        app:icon="@drawable/ic_feed"
                        app:iconGravity="textStart"
                        app:iconPadding="18dp"/>
                </LinearLayout>
                <ToggleButton
                    android:gravity="center"
                    android:id="@+id/button_favorite"
                    android:background="@drawable/button_favorite_selector"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:checked="false"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless"
                    android:textOn=""
                    android:textOff=""
                    android:text=""
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="0dp"/>
                <Button
                    android:gravity="center"
                    android:id="@+id/button_toggle_bio"
                    android:background="@drawable/ic_info_stream"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless"
                    android:textOn=""
                    android:textOff=""
                    android:text=""
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="0dp"/>
                <Button
                    android:gravity="center"
                    android:id="@+id/button_more_options"
                    android:background="@drawable/ic_more_vert"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless"
                    android:text=""
                    android:contentDescription="@string/content_description_more_options"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="0dp"/>
            </LinearLayout>
            <View
                android:id="@+id/bottom_button_divider"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                style="@style/Divider"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/artist_page_bio_sector"
                android:paddingBottom="22dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">&gt; 
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/artist_page_title_biography_section"
                        android:layout_weight="1"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        style="@style/TitleLarge"/>
                    <TextView
                        android:id="@+id/bio_more_text_view_clickable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/artist_page_title_biography_more_button"
                        android:paddingEnd="16dp"
                        style="@style/TitleMedium"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/bio_text_view"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    style="@style/TitleMedium"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/artist_page_top_songs_sector"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/artist_page_title_most_streamed_song_section"
                        android:layout_weight="1"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        style="@style/TitleLarge"/>
                    <TextView
                        android:id="@+id/most_streamed_song_text_view_clickable"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/artist_page_title_most_streamed_song_see_all_button"
                        android:paddingStart="5dp"
                        android:paddingEnd="16dp"
                        style="@style/TitleMedium"/>
                </LinearLayout>
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/most_streamed_song_recycler_placeholder"
                    android:paddingTop="@dimen/_6sdp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/artist_top_songs_height"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include
                            android:id="@+id/item_song_placeholder_1"
                            layout="@layout/item_song_placeholder"/>
                        <include
                            android:id="@+id/item_song_placeholder_2"
                            layout="@layout/item_song_placeholder"/>
                        <include
                            android:id="@+id/item_song_placeholder_3"
                            layout="@layout/item_song_placeholder"/>
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>
                <TextView
                    android:gravity="center"
                    android:id="@+id/most_streamed_song_recycler_empty"
                    android:paddingTop="@dimen/_8sdp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/artist_top_songs_height"
                    android:text="@string/artist_page_title_most_streamed_song_unavailable"/>
                <LinearLayout
                    android:id="@+id/most_streamed_song_recycler_container"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/artist_top_songs_height">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/most_streamed_song_recycler_view"
                        android:visibility="gone"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:nestedScrollingEnabled="false"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/artist_page_all_albums_sectors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="vertical"
                    android:id="@+id/all_albums_recycler_view"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/artist_page_appears_on_sector"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/artist_page_title_appears_on_section"
                        android:layout_weight="1"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        style="@style/TitleLarge"/>
                    <TextView
                        android:id="@+id/appears_on_see_all_text_view"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/artist_page_title_most_streamed_song_see_all_button"
                        android:paddingEnd="16dp"
                        style="@style/TitleMedium"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/appears_on_recycler_view"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/similar_artist_sector"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:paddingTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/artist_page_title_album_more_like_this_button"
                    android:paddingStart="16dp"
                    android:paddingEnd="20dp"
                    style="@style/TitleLarge"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/similar_artists_recycler_view"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
