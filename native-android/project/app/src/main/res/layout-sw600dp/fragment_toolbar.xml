<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:background="?attr/colorSurface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_scrollFlags="snap|enterAlways|scroll">
        <LinearLayout
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:id="@+id/toolbar_title_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize">
            <ImageView
                android:layout_gravity="top"
                android:background="@drawable/ic_toolbar_tempo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="6dp"/>
            <LinearLayout
                android:layout_gravity="top"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <TextView
                    android:textSize="20sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    style="@style/HeadlineMedium"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textSize="13sp"
                    android:ellipsize="end"
                    android:id="@+id/toolbar_music_library_text_view"
                    android:background="?attr/selectableItemBackground"
                    android:visibility="gone"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:drawablePadding="2dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>
</com.google.android.material.appbar.AppBarLayout>
