<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="18dp"
    android:paddingTop="12dp"
    android:paddingRight="18dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:paddingHorizontal="12dp">
    <com.google.android.material.card.MaterialCardView
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginRight="0dp"
        android:layout_marginBottom="0dp"
        android:foreground="@android:color/transparent"
        android:layout_weight="0"
        android:contentDescription="@string/homemusic_wave_title"
        android:layout_marginHorizontal="4dp"
        app:cardBackgroundColor="#00000000"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:rippleColor="#00000000"
        app:strokeColor="#00000000"
        app:strokeWidth="0dp"
        style="?attr/materialCardViewFilledStyle">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="@android:color/transparent"
            android:paddingLeft="12dp"
            android:paddingTop="22dp"
            android:paddingRight="12dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="176dp">
            <TextView
                android:textSize="29sp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/homemusic_wave_title"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:textAllCaps="true"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.12"/>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/homemusic_wave_card"
                android:background="@drawable/aura_wave_play_button"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_marginTop="17dp"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/home_title_radio_station"
                android:importantForAccessibility="no">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/aura_wave_play_icon"
                    android:contentDescription="@null"/>
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/homemusic_mix_card"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_weight="1"
        android:contentDescription="@string/homemusic_mix_title"
        android:layout_marginHorizontal="4dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="16dp"
        style="?attr/materialCardViewFilledStyle">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="104dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_playlist"
                    android:importantForAccessibility="no"
                    app:tint="?attr/colorPrimary"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:ellipsize="end"
                    android:id="@+id/homemusic_mix_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/homemusic_mix_title"
                    android:maxLines="1"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:ellipsize="end"
                    android:id="@+id/homemusic_mix_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"/>
            </LinearLayout>
            <ImageButton
                android:layout_gravity="end|top"
                android:id="@+id/homemusic_mix_play"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_play"
                android:contentDescription="@string/homemusic_mix_play"
                app:tint="?attr/colorOnSurface"/>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
