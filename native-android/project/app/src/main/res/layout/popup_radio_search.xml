<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_popup_search"
    android:paddingTop="8dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="8dp">
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/radio_editor_search_directory"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <com.google.android.material.textfield.TextInputLayout
            android:textColorHint="?android:attr/textColorHint"
            android:id="@+id/popup_search_name_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:endIconMode="clear_text"
            app:endIconTint="?android:attr/textColorSecondary"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">
            <com.google.android.material.textfield.TextInputEditText
                android:textSize="14sp"
                android:id="@+id/popup_search_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/radio_search_hint"
                android:inputType="textNoSuggestions"
                android:imeOptions="actionSearch"
                android:textCursorDrawable="@null"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:textColorHint="?android:attr/textColorHint"
            android:id="@+id/popup_country_layout"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            app:endIconDrawable="@drawable/ic_expand_more"
            app:endIconMode="custom"
            app:endIconTint="?android:attr/textColorSecondary"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">
            <com.google.android.material.textfield.TextInputEditText
                android:textSize="14sp"
                android:id="@+id/popup_country_dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/radio_search_country_hint"
                android:inputType="textNoSuggestions"
                android:textCursorDrawable="@null"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            android:textSize="12sp"
            android:id="@+id/popup_search_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/radio_search_button"
            android:textAllCaps="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginStart="6dp"
            style="@style/Widget.Material3.Button.TonalButton"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/popup_progress_bar"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="13sp"
                android:textColor="?android:attr/textColorHint"
                android:gravity="center"
                android:id="@+id/popup_empty_results"
                android:padding="16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/radio_search_no_results"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/popup_results_recycler"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <ListView
            android:id="@+id/popup_country_list"
            android:background="?attr/colorSurface"
            android:visibility="gone"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:elevation="12dp"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/popup_cancel_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/radio_editor_dialog_negative_button"
            android:textAllCaps="false"
            style="@style/Widget.Material3.Button.TextButton"/>
    </LinearLayout>
</LinearLayout>
