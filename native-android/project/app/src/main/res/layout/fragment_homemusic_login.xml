<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hm_login_root"
    android:background="?attr/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="40dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@null"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/homemusic_login_title"
            style="@style/HeadlineSmall"/>
        <TextView
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:id="@+id/hm_login_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            style="@style/BodyMedium"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/hm_login_server_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/hm_login_server_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/homemusic_login_server"
                app:endIconMode="clear_text"
                app:helperText="@string/homemusic_login_server_helper"
                style="@style/HomeMusicLoginField">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/hm_login_server"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:inputType="textUri"
                    android:imeOptions="actionGo"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:textColor="?attr/colorPrimary"
                android:gravity="center_vertical"
                android:layout_gravity="end"
                android:id="@+id/hm_login_server_default"
                android:background="?attr/selectableItemBackground"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/homemusic_login_server_reset"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                style="@style/BodyMedium"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/hm_login_account_step"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/hm_login_server_row"
                android:background="?attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:minHeight="48dp">
                <TextView
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:ellipsize="middle"
                    android:id="@+id/hm_login_server_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_weight="1"
                    style="@style/BodyMedium"/>
                <TextView
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/homemusic_login_change_server"
                    android:paddingStart="12dp"
                    style="@style/BodyMedium"/>
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/hm_login_email_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/homemusic_login_email"
                style="@style/HomeMusicLoginField">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/hm_login_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:inputType="textEmailAddress"
                    android:imeOptions="actionGo"
                    android:autofillHints="emailAddress"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/hm_login_code_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/homemusic_login_code"
                app:placeholderText="ABCD-EFGH"
                style="@style/HomeMusicLoginField">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/hm_login_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:maxLength="12"
                    android:inputType="textNoSuggestions"
                    android:letterSpacing="0.1"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:layout_gravity="end"
                android:id="@+id/hm_login_resend"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:layout_marginBottom="4dp"
                android:minHeight="48dp"
                style="@style/Widget.Material3.Button.TextButton"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/hm_login_user_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/homemusic_login_user"
                style="@style/HomeMusicLoginField">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/hm_login_user"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:inputType="textNoSuggestions"
                    android:autofillHints="username"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/hm_login_password_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/homemusic_login_password"
                app:endIconMode="password_toggle"
                style="@style/HomeMusicLoginField">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/hm_login_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:inputType="textPassword"
                    android:imeOptions="actionGo"
                    android:autofillHints="password"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/hm_login_password2_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/homemusic_login_password2"
                app:endIconMode="password_toggle"
                style="@style/HomeMusicLoginField">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/hm_login_password2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:inputType="textPassword"
                    android:imeOptions="actionGo"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <TextView
            android:textColor="?attr/colorError"
            android:id="@+id/hm_login_error"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            style="@style/BodyMedium"/>
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/hm_login_progress"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:indeterminate="true"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/hm_login_primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/hm_login_google"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/homemusic_login_google"
            style="@style/Widget.Material3.Button.OutlinedButton"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/hm_login_email_switch"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/homemusic_login_to_email"
            style="@style/Widget.Material3.Button.TextButton"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/hm_login_switch"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            style="@style/Widget.Material3.Button.TextButton"/>
        <TextView
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:id="@+id/hm_login_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/BodySmall"/>
    </LinearLayout>
</ScrollView>
