<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#ee22283e"
                android:endColor="#ee19434a"
                android:angle="0"
                android:centerColor="#ee25384b"/>
            <corners android:radius="28dp"/>
            <stroke
                android:width="1dp"
                android:color="#669bb3c8"/>
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp"/>
            <solid android:color="#12ffffff"/>
        </shape>
    </item>
</layer-list>
